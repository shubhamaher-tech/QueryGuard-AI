# ==============================================================================
# QueryGuard AI - Environment Configuration Example
# ==============================================================================

# Application Database (QueryGuard Metadata & Telemetry Store)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/queryguard

# When running inside Docker Compose:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/queryguard

# Workload Database (Synthetic Workload Telemetry Source - Read Only)
WORKLOAD_DATABASE_URL=postgresql+psycopg2://workload_ro:workload_ro_pass@localhost:5433/workload_db

# When running inside Docker Compose:
# WORKLOAD_DATABASE_URL=postgresql+psycopg2://workload_ro:workload_ro_pass@workload-postgres:5432/workload_db

# Tenant-Scoped HMAC Secret for Deterministic Identifier Tokenization
# NOTE: Set a secure, random string in production. Never commit real secrets.
HMAC_TOKEN_SECRET=replace-with-secure-tenant-hmac-secret-salt

# Project Metadata
PROJECT_NAME="QueryGuard AI"
VERSION="1.0.0"

# Mock DBA Credentials (for initial MVP)
MOCK_DBA_USER_ID=DBA_ADMIN_01
MOCK_DBA_USER_NAME="Lead Database Architect"

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Privacy-Safe Ollama / SLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
# When running inside Docker Compose:
# OLLAMA_BASE_URL=http://ollama:11434

# Recommended lightweight models:
# - qwen2.5-coder:1.5b (~1.5GB RAM, fast, ideal for developer laptops)
# - llama3.2:3b (~2.5GB RAM)
# - qwen2.5-coder:7b (~5GB RAM, requires 16GB+ system RAM)
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=45
REWRITE_IMPROVEMENT_THRESHOLD_PCT=10.0
REWRITE_CACHE_TTL_SECONDS=300
